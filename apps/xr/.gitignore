# Unity project (based on github/gitignore Unity.gitignore)

/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Episodes are local test data (Pepper&Carrot is internal R&D only, never committed or shipped)
/[Aa]ssets/[Ss]treamingAssets/Episodes/
/[Aa]ssets/[Ss]treamingAssets/Episodes.meta

# Autogenerated by Unity
/[Aa]ssets/Plugins/Editor/JetBrains*
/[Aa]ssets/AddressableAssetsData/*/*.bin*
/[Aa]ssets/StreamingAssets/aa.meta
/[Aa]ssets/StreamingAssets/aa/*
/[Aa]ssets/[Ss]treamingAssets/aa/*

# IDEs
.vs/
.vscode/
.idea/
.gradle/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Crash reports
sysinfo.txt
mono_crash.*

# Builds
*.apk
*.aab
*.unitypackage
*.app
crashlytics-build.properties
*_BurstDebugInformation_DoNotShip/

# Meta Immersive Debugger dev agent: holds this machine's LAN IP and a generated access token.
# The SDK recreates it per machine.
/[Aa]ssets/Resources/DevAgentSettings.asset
/[Aa]ssets/Resources/DevAgentSettings.asset.meta

# Local leftovers: an archive of UI/, Unity crash-recovery scenes, the XR operator layer the Meta tool drops in
/UI.rar
/[Aa]ssets/_Recovery/
/[Aa]ssets/_Recovery.meta
/[Aa]ssets/XR/APILayers~/

# Episodes held out of a build (moved here from StreamingAssets/Episodes so they are not packed into the app)
/EpisodesHeld/
/.utmp/
